# Copy to .env and adjust. Never commit real secrets.

# --- Backend ---
SERVER_PORT=8080
DATABASE_URL=jdbc:postgresql://localhost:5432/mavora
DATABASE_USERNAME=mavora
DATABASE_PASSWORD=mavora

# Comma-separated. Used when the SPA is not proxied by Vite.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cookie Secure flag. Keep false on local HTTP. True behind HTTPS.
COOKIE_SECURE=false
SESSION_TTL=14d

# LLM. Default is a deterministic fake provider (no network).
LLM_PROVIDER=fake
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL_CMO=mavora-fake
LLM_MONTHLY_BUDGET_CENTS=2000

# Instagram. Default is a fake professional account (no Meta app).
INSTAGRAM_PROVIDER=fake
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:8080/api/v1/integrations/instagram/callback
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:8080
MAVORA_CRYPTO_SECRET=mavora-dev-only-change-me
MAVORA_MEDIA_DIR=data/media

# --- Frontend ---
# Leave empty to use the Vite proxy in development (/api → backend).
VITE_API_BASE_URL=
